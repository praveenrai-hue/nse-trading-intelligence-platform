# =============================================================================
# NSE Trading Intelligence Platform — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in real values.
#   cp .env.example .env.local
#
# IMPORTANT: Never commit .env.local or any file containing real secrets.
# =============================================================================

# --- Node ---
NODE_ENV=development

# --- Database (Supabase PostgreSQL) ---
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-supabase-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>

# --- Redis ---
REDIS_URL=redis://<user>:<password>@<host>:6379

# --- Authentication (Firebase) ---
NEXT_PUBLIC_FIREBASE_API_KEY=<your-firebase-api-key>
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=<project>.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=<project-id>
FIREBASE_ADMIN_CLIENT_EMAIL=<service-account-email>
FIREBASE_ADMIN_PRIVATE_KEY=<service-account-private-key>

# --- JWT ---
JWT_SECRET=<min-256-bit-random-string>
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d

# --- AI / LLM ---
OPENAI_API_KEY=sk-<your-openai-api-key>
GOOGLE_GEMINI_API_KEY=<your-gemini-api-key>

# --- Payment ---
STRIPE_SECRET_KEY=sk_test_<your-stripe-secret-key>
STRIPE_WEBHOOK_SECRET=whsec_<your-webhook-secret>
RAZORPAY_KEY_ID=<your-razorpay-key-id>
RAZORPAY_KEY_SECRET=<your-razorpay-key-secret>

# --- Email (SendGrid) ---
SENDGRID_API_KEY=SG.<your-sendgrid-api-key>

# --- SMS (Twilio) ---
TWILIO_ACCOUNT_SID=<your-twilio-account-sid>
TWILIO_AUTH_TOKEN=<your-twilio-auth-token>

# --- NSE Data Source ---
NSE_DATA_API_KEY=<your-nse-data-api-key>
NSE_DATA_API_URL=<your-nse-data-provider-url>

# --- Google OAuth ---
GOOGLE_CLIENT_ID=<your-google-client-id>
GOOGLE_CLIENT_SECRET=<your-google-client-secret>

# --- App URLs ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# --- Sentry (Error Tracking) ---
SENTRY_DSN=<your-sentry-dsn>

# --- Feature Flags ---
ENABLE_AI_CHAT=false
ENABLE_PREMIUM_FEATURES=false
