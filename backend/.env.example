# Backend configuration
# Copy to .env and adjust as needed.

# PostgreSQL connection
DATABASE_URL=postgresql+psycopg2://nse:nse@localhost:5432/nse_intel

# API server
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
ENVIRONMENT=development

# CORS (comma separated origins). Use * for all during local dev.
CORS_ORIGINS=http://localhost:3000

# Symbols to track (comma separated). Index symbols use option-chain-indices.
INDEX_SYMBOLS=NIFTY,BANKNIFTY,FINNIFTY
STOCK_SYMBOLS=RELIANCE,HDFCBANK,INFY,TCS,ICICIBANK

# NSE data source
NSE_BASE_URL=https://www.nseindia.com
NSE_REQUEST_TIMEOUT=10
NSE_MAX_RETRIES=3
NSE_RETRY_BACKOFF=1.5

# Ingestion / scanner
REFRESH_INTERVAL_SECONDS=30
# When true, uses synthetic sample data instead of hitting NSE (useful offline/CI).
USE_MOCK_NSE=true
